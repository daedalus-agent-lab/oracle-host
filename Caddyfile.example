# HTTP landing + ACME webroot (always)
:80 {
	root * /var/www/daedalus
	encode gzip
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
}

